{{ define "main" }}
<section class="lc-page-section">
  <header class="lc-page-header lc-page-header--with-aside">
    <div>
      <h1 class="lc-page-title">Cert <code class="lc-mono">{{ .Cert.ID }}</code></h1>
      <p class="lc-page-lede">Recorded {{ formatDate .Cert.CreatedAt }} for customer <code class="lc-mono">{{ .Cert.CustomerID }}</code>. The chain below is re-verified live against the Lucairn witness.</p>
    </div>
    <aside class="lc-header-aside">
      <a class="lc-link" href="/certs/{{ .Cert.ID }}/validator">Signatures</a>
      <a class="lc-link" href="/certs">Back to browser</a>
    </aside>
  </header>

  {{ if .WitnessErr }}
    <div class="lc-banner lc-banner--warn" role="alert">
      <strong>Witness unreachable.</strong> {{ .WitnessErr }}
    </div>
  {{ end }}

  <div class="lc-cert-summary lc-card">
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Overall verdict</span>
      <span>
        {{ if eq .Result.OverallVerdict "verified" }}<span class="lc-pill lc-pill--ok">verified</span>
        {{ else if eq .Result.OverallVerdict "partial" }}<span class="lc-pill lc-pill--warn">partial</span>
        {{ else if eq .Result.OverallVerdict "failed" }}<span class="lc-pill lc-pill--fail">failed</span>
        {{ else }}<span class="lc-text-muted font-tabular">{{ .Result.OverallVerdict }}</span>{{ end }}
        {{ if .Result.ByokExempt }}<span class="lc-badge lc-badge-info" title="BYOK run — customer-supplied LLM key forwarded">BYOK_EXEMPT</span>{{ end }}
      </span>
    </div>
    {{- /*
      T-600 S3 / T-617 S3 — the CLAIM CEILING (PRD specs/2026-09/
      prd-2026-09-21-t600-t617-coverage-attestation-stream.md § Slice D,
      T-600 PRD Marc lock 4).

      ⛔ NEVER render the raw .Result.Completeness token on its own again.
      The bare enum was the reader-inference defect: "full" is true about the CLAIM
      CHAIN and reads as "nothing was missed" about the SCAN. T-313 measured
      a model returning parse_status="ok" over a complete coverage manifest
      at ~19% recall. CompletenessDisplay carries the verdict word plus the
      caveat; the coverage rows below carry the scope, the recall evidence
      and the ceiling.
    */ -}}
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Completeness</span>
      <span>
        {{- if .Result.CompletenessDisplay }}{{ .Result.CompletenessDisplay }}
        {{- else }}<span class="lc-text-muted">unavailable</span>{{ end -}}
      </span>
    </div>
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Signatures valid</span>
      <span class="font-tabular">{{ if .Result.SignaturesValid }}yes{{ else }}no{{ end }}</span>
    </div>
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Isolation verified</span>
      <span class="font-tabular">{{ if .Result.IsolationVerified }}yes{{ else }}no{{ end }}</span>
    </div>
    {{ if .Result.TSATimestamp }}
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">TSA timestamp</span>
      {{- /*
        TSA timestamp tokens are opaque RFC 3161 envelope bytes (hex-
        encoded on the way out of the witness), NOT a URL. Render as
        <code> truncated to 32 hex chars with an ellipsis; the full
        value lives in the per-claim canonical payload anyone with
        offline-verify tooling can reconstruct from the cert envelope.
      */ -}}
      <span class="font-tabular">
        <code class="lc-mono">
          {{ if gt (len .Result.TSATimestamp) 32 -}}
            {{ slice .Result.TSATimestamp 0 32 }}…
          {{- else -}}
            {{ .Result.TSATimestamp }}
          {{- end }}
        </code>
      </span>
    </div>
    {{ end }}
    {{ if .RekorURL }}
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Rekor entry</span>
      <a class="lc-link font-tabular" href="{{ .RekorURL }}" target="_blank" rel="noopener noreferrer"><code class="lc-mono">{{ .Result.RekorUUID }}</code></a>
    </div>
    {{ end }}
    {{- /*
      The L3 coverage block. Keyed on Ceiling: it is non-empty for every
      narrative the verify client builds (including certificates that carry
      NEITHER record — those render "unavailable"), and empty only when no
      narrative was built at all, i.e. the witness-unreachable path where
      .Result is the zero value and the banner above already says so.

      ⛔ Absence is NOT innocence: "scope unavailable" / "recall evidence
      unavailable" never mean "nothing was excluded" or "the scan was clean".
      ⛔ No field keys, receipt ids, source claim ids or zone names appear
      here — the narrative builder never produces them.
    */ -}}
    {{ if .Result.L3Coverage.Ceiling }}
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Deep-shield coverage (scope)</span>
      <span>{{ .Result.L3Coverage.Scope }}</span>
    </div>
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Recall evidence</span>
      <span>{{ .Result.L3Coverage.Evidence }}</span>
    </div>
    {{ if .Result.L3Coverage.Composed }}
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Composed completeness rule</span>
      <span>{{ .Result.L3Coverage.Composed }}</span>
    </div>
    {{ end }}
    {{ if .Result.L3Coverage.Diagnostic }}
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Status of these lines</span>
      <span>{{ .Result.L3Coverage.Diagnostic }}</span>
    </div>
    {{ end }}
    {{- /*
      The raw closed-vocabulary tokens behind the prose above. The narrative
      struct documents them as "so an operator can read the machine state
      without parsing prose" — so they are rendered, not merely carried. An
      operator diagnosing a deployment needs `absent` vs `not_checked` vs
      `unsupported_derivation` as tokens, and drives_verdict is the flag that
      decides whether `composed_green` is load-bearing at all.

      Field keys, receipt ids and zone names are NOT in this row either — the
      narrative struct carries none.
    */ -}}
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">Record state (raw)</span>
      <span class="font-tabular">scope={{ if .Result.L3Coverage.ScopeStatus }}{{ .Result.L3Coverage.ScopeStatus }}{{ else }}unset{{ end }} &middot; evidence={{ if .Result.L3Coverage.EvidenceStatus }}{{ .Result.L3Coverage.EvidenceStatus }}{{ else }}unset{{ end }} &middot; rollup={{ if .Result.L3Coverage.EvidenceRollup }}{{ .Result.L3Coverage.EvidenceRollup }}{{ else }}unset{{ end }} &middot; drives_verdict={{ if .Result.L3Coverage.DrivesVerdict }}true{{ else }}false{{ end }}</span>
    </div>
    <div class="lc-cert-summary-row">
      <span class="lc-text-muted">What coverage does not say</span>
      <span>{{ .Result.L3Coverage.Ceiling }}</span>
    </div>
    {{ end }}
    <form class="lc-cert-summary-actions" method="post" action="/certs/{{ .Cert.ID }}/reverify">
      <input type="hidden" name="csrf" value="{{ .CSRFToken }}">
      <button type="submit" class="lc-primary-button">Re-verify now</button>
    </form>
  </div>

  {{ template "claim_chain" . }}

  {{ if .Result.Error }}
    <div class="lc-banner lc-banner--fail" role="alert">
      <strong>Verifier error.</strong> <code class="lc-mono">{{ .Result.Error }}</code>
    </div>
  {{ end }}
</section>
{{ end }}
