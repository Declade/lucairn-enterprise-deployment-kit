# Reverse proxy for the Lucairn gateway (Caddy 2). INSTALL.md § "Reverse proxy".
#
# The gateway listens on 127.0.0.1:8080 only (docker-compose.customer.yml).
# This file gives the consultants' laptops HTTPS to it and nothing else:
#   * an ALLOW-LIST: the matcher @laptops below forwards exactly these paths
#     and nothing else: /v1/* (Claude Code), /mcp and /mcp/*, /api/v1/veil/*
#     (certificate reads), /api/v1/usage, /api/v1/keys/self/revoke and the
#     four .well-known documents
#     (/.well-known/veil-keys.json, /.well-known/oauth-authorization-server,
#     /.well-known/oauth-protected-resource,
#     /.well-known/mcp/server-card.json); every other path answers 404. Not
#     forwarded, among others: /api/v1/register and /api/v1/scan
#     (unauthenticated on images 1.1.1), the admin and website routes.
#     Opt-in (add them to @laptops only if you use them): the four Sensitive
#     Mode routes (/api/v1/sanitize-only, /api/v1/relink-stream,
#     /api/v1/sensitive-mode/seal-cert, /api/v1/sensitive-mode/account) and
#     the proxy and MCP transports /api/v1/proxy/* and /api/v1/mcp/*.
#     Mint keys on the server itself (bin/lucairn-mint-customer talks to
#     127.0.0.1).
#   * two certificate views are open by design, without a key: the public
#     summary (/api/v1/veil/certificate/<id>/public-summary) and the PDF
#     (/api/v1/veil/certificate/<id>.pdf); anyone with a certificate id can
#     read them through this proxy;
#   * the admin header X-Admin-Key is removed from every forwarded request,
#     so a laptop cannot use it for cross-customer certificate reads;
#   * the health port 127.0.0.1:8085 (/metrics, /invariant) is never forwarded;
#   * X-Real-IP, the one header the gateway reads for the caller's address, is
#     OVERWRITTEN with the address Caddy sees, so a laptop cannot choose it;
#   * streamed answers are passed on at once (flush_interval -1) and long
#     agent turns are not cut (15 minute timeouts).
#
# Replace lucairn.internal.example with your host name and set in customer.env:
#   GATEWAY_BASE_URL=https://lucairn.internal.example
#   GATEWAY_TRUSTED_PROXY_CIDRS=<the Docker bridge gateway address(es), /32>
# The gateway does not see this proxy as 127.0.0.1: Docker hands a connection
# to the published 127.0.0.1:8080 port to the container from the gateway
# address of a Docker bridge network. Read those addresses after the first
# `bin/lucairn up` (INSTALL.md § "Reverse proxy"):
#   docker inspect -f '{{range .NetworkSettings.Networks}}{{println .Gateway}}{{end}}' \
#     "$(docker ps -q --filter label=com.docker.compose.service=gateway)" \
#     | grep -E '^[0-9]+(\.[0-9]+){3}$' | sed 's|$|/32|' | paste -sd, -
# (the filter drops "invalid IP", which Docker 29 prints for the internal
# networks) and put the printed line into GATEWAY_TRUSTED_PROXY_CIDRS, then:
#   bin/lucairn up --env customer.env

lucairn.internal.example {
	# A public name gets its certificate automatically. For an internal name,
	# use your company CA's certificate instead:
	# tls /etc/caddy/certs/lucairn.crt /etc/caddy/certs/lucairn.key

	@laptops path /v1/* /api/v1/veil/* /api/v1/usage /api/v1/keys/self/revoke /mcp /mcp/* /.well-known/veil-keys.json /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/mcp/server-card.json

	handle @laptops {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
			header_up -X-Admin-Key
			flush_interval -1
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	handle {
		respond 404
	}
}
